[64.595953, "o", "bh-x280-3: cpus 0-3, 1.9 GB RAM, lan0 10.80.0.13/24\r\n"]
[64.599592, "o", "\u001b[36m# L2CPU 0 and 1 each own a 4 GB DRAM tile; L2CPU 2 and 3 split one 4 GB tile.\u001b[0m\r\n"]
[64.599704, "o", "\u001b[36m# lan0 is a virtual Ethernet between the guests, relayed by the host over PCIe.\u001b[0m\r\n\r\n"]
[64.599791, "o", "\u001b[1m\u001b[33m## 3. Inside one guest, -np 16 cannot reach the other tiles\u001b[0m\r\n"]
