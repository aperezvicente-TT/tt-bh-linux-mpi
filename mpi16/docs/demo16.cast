[115.947812, "o", "\u001b[36m# Inside a tile Open MPI uses shared memory. Across tiles there is no coherence,\u001b[0m\r\n"]
[115.947855, "o", "\u001b[36m# so traffic needs a transport: here TCP over lan0, relayed by the host.\u001b[0m\r\n\u001b[36m# A NoC-native transport (rings in DRAM written through X280 NoC TLB windows)\u001b[0m\r\n"]
[115.94805, "o", "\u001b[36m# would avoid the host round trip.\u001b[0m\r\n\r\n"]
